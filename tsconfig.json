{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["worker-configuration.d.ts", "apps/web/**/*.ts", "apps/web/**/*.tsx", "apps/edge/**/*.ts", "apps/mcp/**/*.ts", "test/**/*.ts"]
}
