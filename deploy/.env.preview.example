# Copy to .env.preview on the Tencent host and chmod 600.
# Use four independent, randomly generated secrets; never reuse production values.
POSTGRES_PASSWORD=REPLACE_WITH_PREVIEW_DB_PASSWORD
WEB_ACCESS_TOKEN=REPLACE_WITH_PREVIEW_WEB_TOKEN
AGENT_ACCESS_TOKEN=REPLACE_WITH_PREVIEW_AGENT_TOKEN
EDGE_GATEWAY_TOKEN=REPLACE_WITH_PREVIEW_GATEWAY_TOKEN

# Dedicated loopback ports so the isolated preview project does not collide with production.
POSTGRES_HOST_PORT=55433
API_HOST_PORT=8001
ROUTER_HOST_PORT=8081

# Use the stable Preview custom domain in Cloudflare and FastAPI CORS.
WEB_ORIGINS=https://preview.tasklutein.xswt.fyi
MCP_ALLOWED_ORIGINS=https://preview.tasklutein.xswt.fyi

# Fill this with a separate Cloudflare Tunnel token created for Preview.
CF_TUNNEL_TOKEN=
