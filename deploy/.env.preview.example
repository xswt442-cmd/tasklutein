# Copy to .env.preview on the Tencent host and chmod 600.
# Use independent database and gateway secrets; never reuse production values.
POSTGRES_PASSWORD=REPLACE_WITH_PREVIEW_DB_PASSWORD
EDGE_GATEWAY_TOKEN=REPLACE_WITH_PREVIEW_GATEWAY_TOKEN

# Dedicated loopback ports so the isolated preview project does not collide with production.
POSTGRES_HOST_PORT=55433
API_HOST_PORT=8001
ROUTER_HOST_PORT=8081

# Cloudflare branch Preview URL for the dev branch.
WEB_ORIGINS=https://dev.preview.tasklutein.xswt.fyi
MCP_ALLOWED_ORIGINS=https://dev.preview.tasklutein.xswt.fyi

# Fill this with a separate Cloudflare Tunnel token created for Preview.
CF_TUNNEL_TOKEN=
