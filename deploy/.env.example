# Generate separate strong random values (openssl rand -hex 32).
# Never commit deploy/.env. Keep all credentials out of browser/Vite builds.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_URL_SAFE_PASSWORD
EDGE_GATEWAY_TOKEN=REPLACE_WITH_A_SEPARATE_GATEWAY_SECRET_OF_AT_LEAST_32_CHARACTERS

# Used only for explicit direct-origin browser requests; Worker is same-origin.
WEB_ORIGINS=http://localhost:5173

# Comma-separated allowed browser Origins for HTTP MCP. Headless MCP clients
# usually omit Origin. Requests with an unrecognized Origin will be denied.
MCP_ALLOWED_ORIGINS=

# Optional: cloudflared connector, enable using --profile tunnel.
CF_TUNNEL_TOKEN=
